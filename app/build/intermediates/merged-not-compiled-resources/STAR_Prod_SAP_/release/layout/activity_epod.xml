<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">
    <include layout="@layout/header_common_layout"
        />
    <ScrollView
        android:layout_below="@+id/header_layout"
        android:layout_above="@+id/tv_Ch_Submit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <LinearLayout
                android:id="@+id/ll_top_red"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/colorPrimary"
                >
                <TextView
                    android:id="@+id/tv_border_1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    />
                <LinearLayout
                    android:id="@+id/ll_challan_details"
                    android:layout_below="@+id/tv_border_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    >
                    <TextView
                        android:id="@+id/tv_challan_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Challan Number : xxxxxxxxxxxx"
                        android:textColor="@color/white"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textSize="12sp"
                        />
                    <TextView
                        android:id="@+id/tv_challan_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Challan Date : 00-00-0000 00:00"
                        android:textColor="@color/white"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textSize="12sp"
                        />
                </LinearLayout>
                <TextView
                    android:id="@+id/tv_border_2"
                    android:layout_below="@+id/ll_challan_details"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    />
                <LinearLayout
                    android:id="@+id/ll_del_rcpt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:orientation="horizontal"
                    >
                    <TextView
                        android:id="@+id/tv_challan_del_receipt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Delivery Receipt : "
                        android:textColor="@color/white"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textSize="12sp"
                        />
                    <Button
                        android:id="@+id/tv_challan_del_yes"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"

                        android:textColor="@color/white"
                        android:background="@drawable/gray_border_solid_black_bg"

                        android:gravity="center"
                        android:text="Delivery"
                        android:layout_marginStart="15dp"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        />

                    <Button
                        android:id="@+id/tv_challan_del_no"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"

                        android:gravity="center"
                        android:text="Reject"
                        android:layout_marginStart="9dp"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:background="@drawable/rounded_solid"
                        android:textColor="@color/translucent_black"
                        />
                </LinearLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:layout_below="@+id/ll_top_red"
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="#f3f3f3"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:layout_below="@+id/recycler_view"
                android:id="@+id/recyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#f3f3f3"
                />

        </RelativeLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tv_Ch_Submit"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="Submit"
        android:textColor="@color/white"
        android:background="#363f45"
        android:gravity="center"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:layout_alignParentBottom="true"
        />
</RelativeLayout>