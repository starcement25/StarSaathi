<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="true">
    <androidx.cardview.widget.CardView
        android:id="@+id/cv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_margin="3dp"
        app:elevation="0dp"
        app:cardCornerRadius="5dp"
        >
        <LinearLayout
            android:id="@+id/rl_o_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            >
<!--            android:background="@drawable/rounded_grey"-->
            <ImageView
                android:id="@+id/img_prod"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:src="@drawable/default_"
                android:layout_gravity="center"
                android:paddingTop="3dp"
                />
            <TextView
                android:id="@+id/list_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingTop="2dp"
                android:paddingBottom="4dp"
                android:textSize="12sp"
                android:maxLines="1"
                />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:layout_below="@+id/cv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:paddingBottom="15dp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:gravity="center"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Price Per Piece"
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="3dp"
                android:textSize="12sp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Rs"
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingStart="9dp"
                android:textSize="12sp"
                />
            <TextView
                android:id="@+id/tv_pop_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00.00"
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="3dp"
                android:textSize="12sp"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:gravity="center"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GST"
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="3dp"
                android:textSize="12sp"
                />

            <TextView
                android:id="@+id/tv_pop_gst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00.00"
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="3dp"
                android:textSize="12sp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="%"
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingStart="1dp"
                android:textSize="12sp"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:gravity="center"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Min Order Qty"
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="3dp"
                android:textSize="12sp"
                />

            <TextView
                android:id="@+id/tv_min_order_qty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingStart="9dp"
                android:textSize="12sp"
                />
        </LinearLayout>
       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="horizontal"
           android:layout_gravity="center"
           android:gravity="center"
           android:layout_marginTop="9dp"
           >
           <EditText
               android:id="@+id/etProdQty_new"
               android:layout_width="100dp"
               android:layout_height="wrap_content"
               android:layout_above="@+id/tv_qt_mty"
               android:layout_gravity="center"
               android:gravity="center"
               android:background="@drawable/gray_border_gray_bg"

               android:paddingTop="6dp"
               android:paddingBottom="6dp"
               android:inputType="number"
               android:maxLength="5"
               android:textColor="@color/black"
               android:textSize="12sp"

               />
           <TextView
               android:id="@+id/tv_qt_mty"

               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:text="Qty (Pcs)"
               android:textColor="@color/black"
               android:layout_gravity="center"
               android:gravity="center"
               android:padding="9dp"
               android:textSize="12sp"
               />
       </LinearLayout>

    </LinearLayout>

</RelativeLayout>