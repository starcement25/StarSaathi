<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f3f3f3"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_srch"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_margin="7dp"
        android:background="@drawable/rounded_grey_search"
        android:gravity="center">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:src="@drawable/search_g"
            app:tint="@color/black" />

        <EditText
            android:id="@+id/et_SearchSD"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:layout_weight="8"
            android:background="@null"
            android:hint="Search Order Id"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:padding="5dp"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/ivCrossSD"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:src="@drawable/cross"
            app:tint="@color/black" />
    </LinearLayout>
    <ExpandableListView
        android:id="@+id/exlvTrackOrders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        android:childDivider="#d3d3d3"
        android:divider="@null"
        android:dividerHeight="2dp"
        android:groupIndicator="@null"
        android:listSelector="@color/transparent"
        android:scrollbars="none" />
</LinearLayout>