<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:orientation="vertical"
    android:baselineAligned="false"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/header_dark_blue"
        >
        <ImageView
            android:id="@+id/btn_logout"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_gravity="left|center_vertical"
            android:layout_marginLeft="12dp"
            android:src="@drawable/option_menu"
            android:layout_centerVertical="true"
            />
        <TextView
            android:id="@+id/tv_home_caption"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:gravity="center|left"
            android:maxLines="2"
            android:ellipsize="end"
            android:padding="6dp"
            android:layout_toRightOf="@+id/btn_logout"
            android:layout_toLeftOf="@+id/rl_top_menus"
            />
        <RelativeLayout
            android:id="@+id/rl_top_menus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginRight="12dp"
            >
            <ImageView
                android:id="@+id/ivFilter"
                android:onClick="ivFilter"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/filter"
                android:layout_toRightOf="@+id/ivSYNC"
                android:layout_centerInParent="true"
                android:padding="3dp"
                android:clickable="true"
                android:visibility="gone"
                />

            <ImageView
                android:id="@+id/ivSYNC"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerInParent="true"
                android:layout_toRightOf="@+id/rlNoti"
                android:clickable="true"
                android:onClick="ivSync"
                android:padding="3dp"
                android:src="@drawable/refresh" />
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/rlNoti"
                android:paddingRight="3dp"
                >
                <ImageView
                    android:onClick="ivNotification"
                    android:id="@+id/ivMenuMail"

                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/notification_"
                    android:layout_marginRight="1dp"
                    android:layout_centerInParent="true"
                    />
                <TextView
                    android:id="@+id/tvNotiCount"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/circular"
                    android:layout_centerInParent="true"
                    android:layout_alignParentTop="true"
                    android:textColor="@color/colorRed"
                    android:text="0"
                    android:gravity="center"
                    android:layout_marginTop="3dp"
                    />
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical" >

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1" >

            <!-- The main content view -->

            <RelativeLayout
                android:id="@+id/content_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F1F5F7"
                >
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@+id/tv_btm_bdr"
                    android:scrollbars="none"
                    >
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >
                        <RelativeLayout
                            android:id="@+id/rl_slider"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"

                            >
                            <androidx.viewpager2.widget.ViewPager2
                                android:id="@+id/view_pager2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                />
                            <LinearLayout
                                android:id="@+id/ll_dots"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:layout_centerInParent="true"
                                android:layout_alignParentBottom="true"
                                android:layout_marginBottom="15dp"
                                />
                        </RelativeLayout>
                        <LinearLayout
                            android:id="@+id/ll_3_balance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            >
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:background="#f0f0f0"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp"
                                >

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    >
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/Rs"
                                        android:textColor="@color/black"
                                        android:paddingTop="1.5dp"
                                        android:paddingEnd="1dp"
                                        />
                                    <TextView
                                        android:id="@+id/tv_outstanding_bal"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="@color/black"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:layout_gravity="center"
                                        android:gravity="center"
                                        android:maxLines="2"
                                        android:ellipsize="end"
                                        />
                                </LinearLayout>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Outstanding Balance"

                                    android:textColor="@color/black"
                                    android:textSize="10sp"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:background="#f0f0f0"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp"
                                >

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    >
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/Rs"
                                        android:textColor="@color/black"
                                        android:paddingTop="1.5dp"
                                        android:paddingEnd="1dp"
                                        />
                                    <TextView
                                        android:id="@+id/tv_credit_limit"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="@color/black"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:layout_gravity="center"
                                        android:gravity="center"
                                        android:maxLines="2"
                                        android:ellipsize="end"
                                        />
                                </LinearLayout>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Credit Limit"
                                    android:textColor="@color/black"
                                    android:textSize="10sp"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    />
                            </LinearLayout>
                        </LinearLayout>
                        <org.forcepower.starcement.GridViewScrollable
                            android:id="@+id/grid_menu"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:numColumns="2"
                            android:paddingBottom="2dp"
                            android:background="@color/white"
                            android:verticalSpacing="0dp"
                            android:listSelector="@color/transparent"
                            android:layout_margin="2dp"
                            />
                        <RelativeLayout
                            android:layout_below="@+id/grid_menu"
                            android:id="@+id/rl_game_slider"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:visibility="gone"
                            >
                            <androidx.viewpager2.widget.ViewPager2
                                android:id="@+id/view_game_pager2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                />
                            <LinearLayout
                                android:id="@+id/ll_dots_game"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_centerInParent="true"
                                android:layout_alignParentBottom="true"
                                android:layout_marginBottom="15dp"
                                android:visibility="gone"
                                />
                        </RelativeLayout>
                    </LinearLayout>
                </ScrollView>

                <TextView
                    android:id="@+id/tv_btm_bdr"
                    android:layout_above="@+id/llFYW"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/grey"/>
                <LinearLayout
                    android:id="@+id/llFYW"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:paddingBottom="5dp"
                    android:paddingTop="5dp"
                    android:background="@color/white"
                    >
                    <ImageView
                        android:onClick="ivMnuFB"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:src="@drawable/fb"
                        />
                    <ImageView
                        android:onClick="ivMnuYouTube"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:src="@drawable/youtube"
                        />
                    <ImageView
                        android:onClick="ivMnuFBWeb"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:src="@drawable/web"
                        />
                    <ImageView
                        android:onClick="ivMnuDashboard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:src="@drawable/dashboard"
                        />
                </LinearLayout>
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/option_layout"
                android:layout_width="268dp"
                android:layout_height="match_parent"
                android:layout_gravity="left"
                android:background="@color/white"
                android:orientation="vertical"
                >
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    >
                    <ScrollView
                        android:id="@+id/scrollView1"
                        android:layout_above="@+id/tv_app_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" >

                            <LinearLayout
                                android:id="@+id/user_details_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#F1F5F7"
                                android:orientation="vertical"
                                android:padding="5dp"
                                android:clickable="true"
                                android:onClick="chooseYourImage"
                                >

                                <RelativeLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:background="@drawable/circular_bg" >

                                    <com.mikhaellopez.circularimageview.CircularImageView
                                        android:id="@+id/img_user"
                                        android:layout_width="100dp"
                                        android:layout_height="100dp"
                                        android:layout_centerHorizontal="true"
                                        android:layout_centerVertical="true"
                                        android:layout_gravity="center"
                                        android:src="@drawable/cust_bg"
                                        app:civ_border_width="1dp"
                                        app:civ_border_color="@color/black"

                                        />
                                </RelativeLayout>

                                <TextView
                                    android:id="@+id/txt_username"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:layout_gravity="center_horizontal"
                                    android:textAppearance="?android:attr/textAppearanceMedium"
                                    android:textColor="#003399"
                                    android:textSize="12sp"
                                    android:hint="@string/app_name"
                                    android:gravity="center"
                                    />
                                <TextView
                                    android:id="@+id/txt_update_img"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginBottom="15dp"
                                    android:textColor="@color/white"
                                    android:textSize="12sp"
                                    android:text="Update Image"
                                    android:background="@drawable/rounded_black"
                                    android:paddingTop="3dp"
                                    android:paddingBottom="3dp"
                                    android:paddingLeft="9dp"
                                    android:paddingRight="9dp"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    />
                            </LinearLayout>

                            <!--about_us layout-->
                            <LinearLayout
                                android:id="@+id/about_us_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="#FFFFFF"
                                android:orientation="horizontal"
                                android:padding="10dp"
                                android:clickable="true"
                                android:onClick="myAboutUs"
                                >


                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginLeft="10dp"
                                    android:text="About Us"
                                    android:textSize="13sp"
                                    android:textColor="#003399"

                                    />
                            </LinearLayout>
                            <!--help layout-->
                            <LinearLayout
                                android:id="@+id/help_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="#FFFFFF"
                                android:orientation="horizontal"
                                android:padding="10dp"
                                android:clickable="true"
                                android:onClick="myHelp"
                                >


                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginLeft="10dp"
                                    android:text="Help"
                                    android:textSize="13sp"
                                    android:textColor="#003399"

                                    />
                            </LinearLayout>

                            <!--KYC layout-->
                            <LinearLayout
                                android:id="@+id/kyc_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="#FFFFFF"
                                android:orientation="horizontal"
                                android:padding="10dp"
                                android:clickable="true"
                                android:onClick="myKYC"
                                >


                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginLeft="10dp"
                                    android:text="KYC"
                                    android:textSize="13sp"
                                    android:textColor="#003399"

                                    />
                            </LinearLayout>

                            <!--Payment History layout-->
                            <LinearLayout
                                android:id="@+id/ll_appPaymentHistory"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="#FFFFFF"
                                android:orientation="horizontal"
                                android:padding="10dp"
                                android:clickable="true"
                                android:onClick="appPaymentHistory"
                                >



                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginLeft="10dp"
                                    android:text="App Payment History"
                                    android:textSize="13sp"
                                    android:textColor="#003399"

                                    />
                            </LinearLayout>

                            <!--Issues-->
                            <LinearLayout
                                android:id="@+id/issues_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="#FFFFFF"
                                android:orientation="horizontal"
                                android:padding="10dp"
                                android:clickable="true"
                                android:onClick="myIssues"
                                >


                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginLeft="10dp"
                                    android:text="Issues"
                                    android:textSize="13sp"
                                    android:textColor="#003399"

                                    />
                            </LinearLayout>

                            <!--Terms and conditions layout-->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="#FFFFFF"
                                android:orientation="horizontal"
                                android:padding="10dp"
                                android:clickable="true"
                                android:onClick="Terms_and_Conditions"
                                >


                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginLeft="10dp"
                                    android:text="Terms and Conditions"
                                    android:textSize="13sp"
                                    android:textColor="#003399"

                                    />
                            </LinearLayout>

                            <!--Privacy Policy layout-->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="#FFFFFF"
                                android:orientation="horizontal"
                                android:padding="10dp"
                                android:clickable="true"
                                android:onClick="myPrivacyPolicy"
                                >


                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginLeft="10dp"
                                    android:text="Privacy Policy"
                                    android:textSize="13sp"
                                    android:textColor="#003399"

                                    />
                            </LinearLayout>

                            <!--Refund Policy layout-->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="#FFFFFF"
                                android:orientation="horizontal"
                                android:padding="10dp"
                                android:clickable="true"
                                android:onClick="myRefundPolicy"
                                >


                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginLeft="10dp"
                                    android:text="Refund Policy"
                                    android:textSize="13sp"
                                    android:textColor="#003399"

                                    />
                            </LinearLayout>

                            <!--Credit Limit layout-->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="#FFFFFF"
                                android:orientation="horizontal"
                                android:padding="10dp"
                                android:clickable="true"
                                android:onClick="myCreditLimit"
                                android:visibility="gone"
                                android:id="@+id/ll_credit_limit"
                                >


                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginLeft="10dp"
                                    android:text="Credit Limit"
                                    android:textSize="13sp"
                                    android:textColor="#003399"

                                    />
                            </LinearLayout>

                            <!--ARC CONSUMER SCHEME-->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="#FFFFFF"
                                android:orientation="horizontal"
                                android:padding="10dp"
                                android:clickable="true"
                                android:onClick="_con_scheme"
                                android:visibility="gone"
                                android:id="@+id/ll_arc_con_scheme"
                                >


                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginLeft="10dp"
                                    android:text="Consumer Scheme"
                                    android:textSize="13sp"
                                    android:textColor="#003399"

                                    />
                            </LinearLayout>

                            <!--log out-->
                            <LinearLayout
                                android:id="@+id/logout_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="#FFFFFF"
                                android:orientation="horizontal"
                                android:padding="10dp"
                                android:clickable="true"
                                android:onClick="myLogOut"
                                >

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginLeft="10dp"
                                    android:text="Logout"
                                    android:textSize="13sp"
                                    android:textColor="#003399"

                                    />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/aaa_layout"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="2dp"
                                android:background="#FFFFFF"
                                android:orientation="horizontal"
                                android:padding="10dp" />
                        </LinearLayout>
                    </ScrollView>
                    <TextView
                        android:id="@+id/tv_app_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="App Version : "
                        android:layout_alignParentBottom="true"
                        android:padding="15dp"
                        android:background="@color/white"
                        android:textSize="10sp"
                        />
                </RelativeLayout>
            </LinearLayout>

        </androidx.drawerlayout.widget.DrawerLayout>

    </LinearLayout>

</LinearLayout>