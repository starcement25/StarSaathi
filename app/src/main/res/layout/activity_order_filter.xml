<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!--header-->
    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/colorRed"
        android:orientation="horizontal"
        android:padding="3dp">

        <ImageView
            android:id="@+id/imagelogo"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <ImageView
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:padding="15dp"
            android:src="@drawable/back_bg" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="ORDER DETAILS"
            android:layout_toRightOf="@+id/back"
            android:gravity="center"
            android:textColor="@color/white"
            android:layout_marginLeft="20dp"
            android:textSize="14sp" />

    </RelativeLayout>

    <!--Body-->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/header_layout"
        android:layout_above="@+id/btn_continue"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/ll_order_ship_tp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SHIP TO"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:textColor="@color/grey" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/radio_ship_self"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Self"
                            android:textColor="#003399"
                            android:textSize="15sp" />

                        <RadioButton
                            android:id="@+id/radio_ship_sub_dealer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sub Dealer"
                            android:textColor="#003399"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CONSIGNEE NAME"
                        android:paddingTop="15dp"
                        android:paddingBottom="9dp"
                        android:textColor="@color/grey" />

                    <EditText
                        android:id="@+id/et_con_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:padding="9dp"
                        android:background="@drawable/rounded_grey"
                        android:text=""
                        android:gravity="top"
                        android:maxLines="1"
                        android:inputType="textPostalAddress"
                        android:singleLine="true"
                        android:textSize="12sp"
                        android:digits="@string/spl_charecter" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CONSIGNEE ADDRESS"
                        android:paddingTop="15dp"
                        android:paddingBottom="9dp"
                        android:textColor="@color/grey" />

                    <EditText
                        android:id="@+id/et_con_address"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:textColor="@color/black"
                        android:padding="3dp"
                        android:background="@drawable/rounded_grey"
                        android:text=""
                        android:gravity="top"
                        android:maxLines="9"
                        android:inputType="textMultiLine"
                        android:maxEms="15"
                        android:textSize="12sp"
                        android:digits="@string/spl_charecter" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="15dp"
                    android:paddingBottom="9dp"
                    android:textColor="@color/grey"
                    android:text="DESTINATION ADDRESS" />

                <EditText
                    android:id="@+id/et_destination_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:padding="9dp"
                    android:background="@drawable/rounded_grey"
                    android:text=""
                    android:hint="Select destination address"
                    android:gravity="top"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textSize="12sp"
                    android:editable="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PHONE NO"
                    android:paddingTop="15dp"
                    android:paddingBottom="9dp"
                    android:textColor="@color/grey" />

                <EditText
                    android:id="@+id/et_phone_no"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:padding="9dp"
                    android:background="@drawable/rounded_grey"
                    android:text=""
                    android:gravity="top"
                    android:maxLines="1"
                    android:maxLength="10"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FREIGHT"
                    android:paddingTop="25dp"
                    android:paddingBottom="9dp"
                    android:textColor="@color/grey" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_freight_for"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="FOR"
                        android:textColor="#003399"
                        android:textSize="15sp"
                        android:focusable="false" />

                    <RadioButton
                        android:id="@+id/rb_freight_exw"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="EXW"
                        android:textColor="#003399"
                        android:textSize="15sp"
                        android:focusable="false" />

                    <RadioButton
                        android:id="@+id/rb_freight_dot"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:text="DOT"
                        android:textColor="#003399"
                        android:textSize="15sp"
                        android:focusable="false"
                        android:visibility="invisible" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">
                <!-- PLANT NAME section (visible only when FOR is selected) -->
                <LinearLayout
                    android:id="@+id/ll_plant_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PLANT NAME"
                        android:paddingTop="15dp"
                        android:paddingBottom="9dp"
                        android:textColor="@color/grey" />

                    <EditText
                        android:id="@+id/et_plant_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:padding="9dp"
                        android:background="@drawable/rounded_grey"
                        android:text=""
                        android:gravity="top"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textSize="12sp"
                        android:enabled="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:clickable="false" />
                </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_dump_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="DUMP NAME"
                        android:paddingTop="25dp"
                        android:paddingBottom="9dp"
                        android:textColor="@color/grey" />

                    <TextView
                        android:id="@+id/et_dump_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:padding="9dp"
                        android:background="@drawable/rounded_grey"
                        android:text=""
                        android:hint="Select Dump"
                        android:gravity="top"
                        android:maxLines="1"
                        android:maxLength="99"
                        android:singleLine="true"
                        android:textSize="12sp"
                        android:tag="" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_remarks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Delivery Remarks"
                        android:textAllCaps="true"
                        android:paddingTop="15dp"
                        android:paddingBottom="9dp"
                        android:textColor="@color/grey" />

                    <EditText
                        android:id="@+id/et_delivery_remarks"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:textColor="@color/black"
                        android:padding="3dp"
                        android:background="@drawable/rounded_grey"
                        android:text=""
                        android:gravity="top"
                        android:maxLines="9"
                        android:inputType="textMultiLine"
                        android:maxEms="15"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_dealer_truck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="DEALER TRUCK"
                        android:paddingTop="35dp"
                        android:paddingBottom="9dp"
                        android:textColor="@color/grey" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rb_truck_yes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Yes"
                            android:textColor="#003399"
                            android:textSize="15sp" />

                        <RadioButton
                            android:id="@+id/rb_truck_no"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="No"
                            android:textColor="#003399"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:visibility="invisible" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_continue"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="#363f45"
        android:text="CONTINUE"
        android:textColor="@color/white"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
