<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical"
        android:background="#f3f3f3"
        >
        <!--Header-->
        <RelativeLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentTop="true"
            android:background="@drawable/header_dark_blue"
            android:orientation="vertical"
            xmlns:android="http://schemas.android.com/apk/res/android">
            <ImageView
                android:id="@+id/ivHeaderBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/arrow_back"
                android:layout_centerInParent="true"
                android:layout_alignParentLeft="true"
                android:padding="10dp"
                />
            <TextView
                android:id="@+id/tvHeaderText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:layout_centerInParent="true"
                android:gravity="left"
                android:layout_marginLeft="9dp"
                android:layout_toLeftOf="@+id/ivMonthSelection"
                android:layout_toRightOf="@+id/ivHeaderBack"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                />
            <ImageView
                android:id="@+id/ivMonthSelection"
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:src="@drawable/filter"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:padding="6dp"
                android:layout_toStartOf="@+id/rlNoti"
                android:visibility="gone"
                />
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/rlNoti"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:layout_marginEnd="9dp"
                android:layout_alignParentEnd="true"
                >
                <ImageView
                    android:id="@+id/ivMenuMail"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/cart"
                    android:layout_marginRight="3dp"
                    android:layout_centerInParent="true"
                    />
                <TextView
                    android:id="@+id/tvNotiCount"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/circular"
                    android:layout_centerInParent="true"
                    android:layout_alignParentTop="true"
                    android:textColor="@color/colorRed"
                    android:text="0"
                    android:gravity="center"
                    android:layout_marginTop="3dp"
                    />
            </RelativeLayout>
        </RelativeLayout>

        <!--    Body-->
        <RelativeLayout
            android:layout_below="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:id="@+id/rl_sliderOne"
            >
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/sliding_tabs"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="@color/white"
                app:tabMode="fixed"
                app:tabTextColor="@color/black"
                app:tabSelectedTextColor="@color/colorPrimary"
                >
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pop Order"
                    />
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order History"
                    />
            </com.google.android.material.tabs.TabLayout>
            <androidx.viewpager2.widget.ViewPager2
                android:layout_below="@+id/sliding_tabs"

                android:id="@+id/view_pager2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                />
        </RelativeLayout>


    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>