<?xml version="1.0" encoding="utf-8"?>
 <RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
    android:fitsSystemWindows="true"
        >

        <!--header-->
        <RelativeLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/colorRed"
            android:orientation="horizontal"
            android:padding="3dp" >


            <ImageView
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:padding="15dp"
                android:src="@drawable/back_bg"
                />
            <TextView
                android:id="@+id/tv_caption"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="SELECT PRODUCT"
                android:layout_toRightOf="@+id/back"
                android:gravity="center"
                android:textColor="@color/white"
                android:layout_marginLeft="20dp"
                android:textSize="14sp"
                />

            <ImageView
                android:id="@+id/ivForward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:padding="15dp"
                android:src="@drawable/back_bg"
                android:rotation="180"
                />

        </RelativeLayout>

        <!--body-->

        <LinearLayout
            android:layout_below="@+id/header_layout"
            android:layout_above="@+id/btn_conti"
            android:id="@+id/body_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >

            <!--list of products-->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/blur_bg"
                android:minHeight="150dp"
                android:gravity="center"
                >
                <TextView
                    android:id="@+id/tvOS"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OUTSTANDING"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:layout_below="@+id/tvRs"
                    android:gravity="center"
                    />
                <LinearLayout
                    android:id="@+id/tvRs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    >
                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="match_parent"
                        android:src="@drawable/ruppes_white"
                        />
                    <TextView
                        android:id="@+id/tvOutStanding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" 00.00"
                        android:textColor="@color/white"
                        android:textSize="19sp"
                        android:gravity="center"
                        android:textStyle="bold"
                        />
                </LinearLayout>
            </RelativeLayout>
            <ListView
                android:id="@+id/prodQtyRateListView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="7.7"
                android:divider="@drawable/list_divider"
                />

            <!--empty listview prompt-->
            <TextView
                android:visibility="gone"
                android:id="@+id/empty_text_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="7.7"
                android:gravity="center"
                android:layout_gravity="center"
                android:text="Please Check your Data Connectivity"
                android:textColor="#525252"
                android:textSize="12sp"
                />

        </LinearLayout>
        <Button
            android:id="@+id/btn_conti"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_margin="9dp"
            android:background="#363f45"
            android:text="CONTINUE"
            android:textColor="@color/white"
            android:layout_alignParentBottom="true"
            android:onClick="goto_cart"
            />
    </RelativeLayout>